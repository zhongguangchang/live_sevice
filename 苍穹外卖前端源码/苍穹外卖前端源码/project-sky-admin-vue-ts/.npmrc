# npm 7+ 默认严格校验 peerDependencies，而这个项目是 vue-cli 3 时代的，
# 各插件声明的 eslint / webpack 版本互相冲突，严格模式下必然装不上。
# 打开 legacy-peer-deps 后 npm 会退回 npm 6 的行为，忽略这些冲突。
legacy-peer-deps=true

# 锁文件是 2023 年生成的，里面的下载地址指向 registry.npm.taobao.org。
# 该域名已废弃、HTTPS 证书过期，照搬会导致每个包都 CERT_HAS_EXPIRED 拉不下来。
# 锁文件里的地址已经批量改成 npmmirror，这里再加一道保险：
# 让 npm 自动把锁文件里的 registry 主机名替换成当前配置的 registry。
replace-registry-host=always

# 国内网络下这两个联网检查步骤经常拖慢甚至卡住安装
audit=false
fund=false
