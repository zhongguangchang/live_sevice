<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.sky.mapper.ProviderSkillMapper">

    <insert id="insertBatch">
        insert into provider_skill (provider_id, category_id, level)
        values
        <foreach collection="skills" item="skill" separator=",">
            (#{skill.providerId}, #{skill.categoryId}, #{skill.level})
        </foreach>
    </insert>

    <select id="listByProviderIds" resultType="ProviderSkill">
        select * from provider_skill where provider_id in
        <foreach collection="providerIds" item="providerId" open="(" separator="," close=")">
            #{providerId}
        </foreach>
    </select>

</mapper>
